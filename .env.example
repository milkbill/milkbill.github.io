# Web3Forms — free contact form (client-side, required on free plan)
#
# 1. Create a form at https://app.web3forms.com
# 2. Copy your Access Key
# 3. Paste below and restart: npm run dev
#
# NEXT_PUBLIC_ is required so the browser can submit to Web3Forms directly.
# Web3Forms allows this on the free plan (server-side calls need Pro).

NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY=your_access_key_here

# Local dev
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# GitHub Pages (used by CI — set NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY as a repo secret)
# NEXT_PUBLIC_SITE_URL=https://kawaldeepsingh93.github.io/milktrack-website
